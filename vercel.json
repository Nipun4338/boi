{
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "admin/*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "actions/**/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/(assets|vendor|includes)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "/actions/(.*)",
      "dest": "/actions/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1.php"
    }
  ]
}
