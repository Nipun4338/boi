{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/admin/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/(assets|admin/vendor|admin/css|admin/js|admin/img|includes|js|css|img|scss|icons|font-awesome-4.7.0|images)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
