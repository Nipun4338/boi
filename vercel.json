{
  "version": 2,
  "functions": {
    "**/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/(assets|vendor|includes|js|css|img|scss|icons)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1.php"
    },
    {
      "src": "/actions/(.*)",
      "dest": "/actions/$1.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1.php"
    }
  ]
}
